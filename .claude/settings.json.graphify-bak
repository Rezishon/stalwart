{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/home/rezishon/.local/share/../bin/graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/home/rezishon/.local/share/../bin/graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  }
}