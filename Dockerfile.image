# syntax=docker/dockerfile:1
# Runtime image from a prebuilt musl binary (CI copies `mailiam` into the context).
# Certs stage is BUILDPLATFORM so arm64 images do not qemu apk.
FROM --platform=$BUILDPLATFORM alpine AS certs
RUN apk add --no-cache ca-certificates

FROM scratch
COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --chmod=0755 mailiam /usr/local/bin/mailiam
VOLUME ["/etc/mailiam", "/var/lib/mailiam"]
EXPOSE 443 25 110 587 465 143 993 995 4190 80
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENTRYPOINT ["/usr/local/bin/mailiam"]
CMD ["--config", "/etc/mailiam/config.json"]
